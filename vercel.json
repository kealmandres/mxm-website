{
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/botbuster",
      "destination": "https://botbustervideo.netlify.app/"
    },
    {
      "source": "/botbuster/:path*",
      "destination": "https://botbustervideo.netlify.app/:path*"
    },
    {
      "source": "/agents",
      "destination": "https://mxm-agent-frontend-1.onrender.com/"
    },
    {
      "source": "/agents/:path*",
      "destination": "https://mxm-agent-frontend-1.onrender.com/:path*"
    },
    { "source": "/artificial-ingenious", "destination": "/pages/artificial-ingenious.html" },
    { "source": "/machine-megamind", "destination": "/pages/machine-megamind.html" },
    { "source": "/consults-coded", "destination": "/pages/consults-coded.html" },
    { "source": "/future-observatory", "destination": "/pages/future-observatory.html" },
    { "source": "/blonde-bot-lair", "destination": "/pages/blonde-bot-lair.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/back-to-future", "destination": "/pages/back-to-future.html" },
    { "source": "/success-gallery", "destination": "/pages/success-gallery.html" },
    { "source": "/coming-soon", "destination": "/pages/coming-soon.html" },
    { "source": "/about", "destination": "/pages/blonde-bot-lair.html" },
    { "source": "/privacy-policy", "destination": "/pages/privacy-policy.html" },
    { "source": "/terms-of-service", "destination": "/pages/terms-of-service.html" },
    { "source": "/links", "destination": "/linktree.html" },
    { "source": "/linktree", "destination": "/linktree.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://themxm.ai"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, Accept, Origin"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        },
         {
           "key": "Content-Security-Policy",
           "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://player.vimeo.com https://www.youtube.com https://kit.fontawesome.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://kit.fontawesome.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://kit.fontawesome.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; media-src 'self' https: blob:; frame-src 'self' https://player.vimeo.com https://www.youtube.com https://www.facebook.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://api.rss2json.com https://themxm.app.n8n.cloud https://marissakos.substack.com; object-src 'none'; base-uri 'self'; form-action 'self' https://themxm.app.n8n.cloud; frame-ancestors 'self'"
         },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()"
        }
      ]
    },
    {
      "source": "/botbuster/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, Accept, Origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/agents/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mxm-agent-frontend-1.onrender.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://mxm-agent-frontend-1.onrender.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://mxm-agent-frontend-1.onrender.com; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https://mxm-agent-frontend-1.onrender.com https://mxm-agent-backend.onrender.com https://www.google-analytics.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/agents",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mxm-agent-frontend-1.onrender.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://mxm-agent-frontend-1.onrender.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://mxm-agent-frontend-1.onrender.com; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https://mxm-agent-frontend-1.onrender.com https://mxm-agent-backend.onrender.com https://www.google-analytics.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },    
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/pages/(.*)\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}